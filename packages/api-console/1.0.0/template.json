{
  "schema": "uvp.template/1",
  "id": "api-console",
  "version": "1.0.0",
  "name": "API console",
  "description": "A Postman-style HTTP debugging console: libuvcpp JSON API plus a static SPA with sandboxed HTML preview, history, and saved collections.",
  "category": "fullstack",
  "framework": "h5",
  "tags": [
    "http",
    "client",
