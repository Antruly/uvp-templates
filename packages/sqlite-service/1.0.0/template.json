{
  "schema": "uvp.template/1",
  "id": "sqlite-service",
  "version": "1.0.0",
  "name": "SQLite REST service",
  "description": "A Vue and libuvcpp starter with a SQLite-backed CRUD API, startup schema initialization, and a working records interface.",
  "category": "fullstack",
  "framework": "vue3",
  "tags": [
    "sqlite",
    "database",
    "rest",
    "vue",
    "libuvcpp"
  ],
  "requires": {
    "uvp": ">=0.4.0",
    "libuvcpp": ">=1.9.1 <2.0.0",
    "features": [
      "db"
    ]
  },
  "variables": {
    "name": {
      "type": "slug",
      "required": true,
      "default": "sqlite-service"
    },
    "port": {
      "type": "port",
      "default": 8080
    }
  },
  "routes": [
    "GET /healthz",
    "GET /api/items",
    "GET /api/items/:id",
    "POST /api/items",
    "PUT /api/items/:id",
    "DELETE /api/items/:id",
    "GET /",
    "HEAD /",
    "GET /*path",
    "HEAD /*path"
  ],
