{
  "schema": "uvp.template/1",
  "id": "websocket-console",
  "version": "1.0.0",
  "name": "WebSocket console",
  "description": "A standalone libuvcpp text/binary echo service with a same-origin browser console and bounded message history.",
  "category": "fullstack",
  "tags": [
    "websocket",
    "console",
    "libuvcpp"
  ],
  "requires": {
    "uvp": ">=0.4.0",
    "libuvcpp": ">=1.9.1 <2.0.0",
    "features": [
      "websocket"
    ]
  },
  "variables": {
    "name": {
      "type": "slug",
      "required": true,
      "default": "websocket-console"
    },
    "port": {
      "type": "port",
      "default": 8080
    }
  },
  "routes": [
    "GET /healthz",
    "WS /ws",
    "GET /",
    "HEAD /",
    "GET /*path",
    "HEAD /*path"
  ],
