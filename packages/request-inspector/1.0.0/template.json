{
  "schema": "uvp.template/1",
  "id": "request-inspector",
  "version": "1.0.0",
  "name": "HTTP request inspector",
  "description": "A same-origin HTTP inspection console backed by libuvcpp with explicit byte counts and bounded UTF-8 body previews.",
  "category": "fullstack",
  "tags": [
    "http",
    "inspector",
    "console",
    "libuvcpp"
  ],
  "requires": {
    "uvp": ">=0.4.0",
    "libuvcpp": ">=1.9.1 <2.0.0",
    "features": []
  },
  "variables": {
    "name": {
      "type": "slug",
      "required": true,
      "default": "request-inspector"
    },
    "port": {
      "type": "port",
      "default": 8080
    }
  },
  "routes": [
    "GET /healthz",
    "POST /api/inspect",
    "GET /",
    "HEAD /",
    "GET /*path",
    "HEAD /*path"
  ],
