{
  "schema": "uvp.template/1",
  "id": "admin-console",
  "version": "1.0.0",
  "name": "Vue admin console",
  "description": "A Vue 3 administration shell served by a libuvcpp HTTP service, with an overview API and basic theme and locale preferences.",
  "category": "fullstack",
  "framework": "vue3",
  "tags": [
    "admin",
    "dashboard",
    "vue",
    "vite"
  ],
  "requires": {
    "uvp": ">=0.4.0",
    "libuvcpp": ">=1.9.1 <2.0.0",
    "features": []
  },
  "variables": {
    "name": {
      "type": "slug",
      "required": true,
      "default": "admin-console"
    },
    "port": {
      "type": "port",
      "default": 8080
    }
  },
  "routes": [
    "GET /healthz",
    "GET /api/overview",
    "GET /",
    "HEAD /",
    "GET /*path",
    "HEAD /*path"
  ],
